<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Harmion" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- The approval surface must be opaque: a translucent window lets a
         malicious overlay receive the tap the user intends for "allow". -->
    <style name="Theme.Harmion.Approval" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
