<?xml version="1.0" encoding="utf-8"?>
<!--
  The node identity and its keys are device-bound. Copying them through Auto
  Backup would silently clone a node and leak credentials, so nothing is
  backed up. Moving to a new device means joining the cluster as a new node.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
