[Unit]
Description=Encrypted offsite Harmion backup (%i)
Documentation=file:%h/.local/share/doc/harmion/linux-service.md

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/harmion/backup.env
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/%u/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=HARMIOND=%h/.local/bin/harmiond
ExecStart="%h/.local/bin/harmion-backup" "%h/.local/share/harmion/%i"
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
