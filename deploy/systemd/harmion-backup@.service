[Unit]
Description=Encrypted offsite Harmion backup (%i)
Documentation=file:%h/.local/share/doc/harmion/linux-service.md

[Service]
Type=oneshot
# A hung TLS connection must not leave this unit "activating" forever: the
# daily timer would then skip every later run.
TimeoutStartSec=15min
# The 1Password CLI talks to the desktop app through the user session. A user
# service does not necessarily inherit these from the graphical login session.
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
EnvironmentFile=-%h/.config/harmion/backup.env
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/%u/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=HARMIOND=%h/.local/bin/harmiond
ExecStart="%h/.local/bin/harmion-backup" "%h/.local/share/harmion/%i"
UMask=0077
NoNewPrivileges=yes
# Headless `op` reads with OP_SERVICE_ACCOUNT_TOKEN do not need the desktop
# app; the desktop integration hangs or resets from a oneshot unit, so the
# timer uses a service account token (or the HARMION_CF_TOKEN file) instead.
PrivateTmp=yes
